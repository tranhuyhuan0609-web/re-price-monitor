
ENV=prod

# Host ports used by Docker Compose
KAFKA_HOST_PORT=
KAFKA_UI_HOST_PORT=
MONGO_HOST_PORT=
POSTGRES_HOST_PORT=

# MongoDB
MONGO_HOST=
MONGO_PORT=
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=

# PostgreSQL
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_RAW_TOPIC=
KAFKA_DLQ_TOPIC=
KAFKA_GROUP_DLQ_WRITER=
KAFKA_GROUP_RAW_WRITER=
KAFKA_GROUP_CLEAN_PROCESSOR=
KAFKA_DLQ_FLUSH_TIMEOUT=10.0

# Approved exchange-rate provider
FX_RATE_URL=https://www.vietcombank.com.vn/en/Personal/Cong-cu-Tien-ich/Ty-gia
FX_RATE_SOURCE=vietcombank.com.vn
FX_RATE_FORMAT=vietcombank_html
FX_RATE_TIMEOUT_SECONDS=10
FX_RATE_UPDATE_INTERVAL_SECONDS=3600

PARTITION_MONTHS_AHEAD=2
PARTITION_CHECK_INTERVAL_SECONDS=21600

LIFECYCLE_CHECK_INTERVAL_SECONDS=300
LIFECYCLE_GRACE_SECONDS=600

CRAWLER_LOG_LEVEL=INFO
