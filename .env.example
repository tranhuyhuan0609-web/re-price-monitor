# Copy to .env and replace every placeholder before production deployment.
ENV=prod

# Host ports used by Docker Compose
KAFKA_HOST_PORT=9092
KAFKA_UI_HOST_PORT=8080
MONGO_HOST_PORT=27017
POSTGRES_HOST_PORT=5432

# MongoDB
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=replace_me
MONGO_PASSWORD=replace_me
MONGO_DB=realestate_raw

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=replace_me
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=realestate

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
KAFKA_RAW_TOPIC=realestate.raw.v1
KAFKA_DLQ_TOPIC=realestate.dlq.v1
KAFKA_GROUP_RAW_WRITER=raw-writer
KAFKA_GROUP_CLEAN_PROCESSOR=clean-processor

# Approved exchange-rate provider
FX_RATE_URL=https://replace-with-approved-provider.example/api/rates
FX_RATE_SOURCE=replace-with-approved-provider
FX_RATE_TIMEOUT_SECONDS=10
FX_RATE_UPDATE_INTERVAL_SECONDS=3600

CRAWLER_LOG_LEVEL=INFO
